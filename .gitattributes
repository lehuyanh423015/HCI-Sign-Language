* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary 3D/media assets: never attempt text merge
*.blend binary
*.blend1 binary
*.glb binary
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary

