{
  "name": "hci-sign-language",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nền tảng học Ngôn ngữ Ký hiệu Việt Nam với avatar 3D",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0 <27",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "npm run dev --workspace @hci-sign/web",
    "build": "npm run build --workspace @hci-sign/web",
    "lint": "npm run lint --workspace @hci-sign/web",
    "typecheck": "npm run typecheck --workspace @hci-sign/web",
    "test": "node --test tools/tests/*.test.mjs && npm run test --workspace @hci-sign/web",
    "doctor": "node tools/doctor.mjs",
    "validate:data": "node tools/validate-data.mjs",
    "sync:data": "node tools/sync-data.mjs",
    "sync:data:check": "node tools/sync-data.mjs --check",
    "sync:technical-assets": "node tools/sync-technical-assets.mjs",
    "sync:technical-assets:check": "node tools/sync-technical-assets.mjs --check",
    "validate:assets": "node tools/validate-assets.mjs",
    "validate:technical-asset": "node tools/validate-technical-asset.mjs --report docs/reports/artifacts/TASK-0003-glb-validation.json",
    "validate:neutral-asset": "node tools/validate-technical-asset.mjs --asset assets/exports/technical/technical-hand-test-neutral.glb --report docs/reports/artifacts/TASK-0004-neutral-glb-validation.json",
    "validate:master-static": "node tools/validate-master-glb.mjs --profile MASTER_STATIC --asset assets/exports/master/avatar-master-v1-rc1.glb --report docs/reports/artifacts/TASK-0005-master-static-validation.json",
    "validate:morph-poc": "node tools/validate-master-glb.mjs --profile MORPH_POC --asset docs/reports/artifacts/TASK-0005-morph-poc.glb --report docs/reports/artifacts/TASK-0005-morph-poc-validation.json",
    "validate:facial-asset": "node tools/validate-facial-asset.mjs",
    "validate:master-v1": "node tools/validate-master-v1-release.mjs",
    "validate:sign-packages": "node tools/validate-sign-package.mjs --pilot-glb assets/exports/technical/task-0009/technical-sign-pipeline-pilot.glb --pilot-clip TECH_HAND_FACE_TEST",
    "validate:motion-spec": "node tools/validate-sign-motion-spec.mjs --report docs/reports/artifacts/TASK-0010/motion-spec-validation.json",
    "validate:pose-pilot": "node tools/validate-pose-authoring-pilot.mjs",
    "verify:master": "node tools/verify-master-manifest.mjs",
    "test:technical-viewer": "node tools/test-technical-viewer.mjs --url http://127.0.0.1:4173/technical-viewer --report docs/reports/artifacts/TASK-0003-browser-runtime.json --screenshot docs/reports/artifacts/TASK-0003-browser-runtime.png",
    "test:neutral-viewer": "node tools/test-technical-viewer.mjs --url http://127.0.0.1:4173/technical-viewer --report docs/reports/artifacts/TASK-0004-browser-runtime.json --full-screenshot docs/reports/artifacts/TASK-0004-browser-full.png --screenshot docs/reports/artifacts/TASK-0004-browser-runtime.png",
    "test:facial-viewer": "node tools/test-facial-viewer.mjs",
    "test:sign-preview": "node tools/test-technical-viewer.mjs --url http://127.0.0.1:4173/technical-sign-preview --report docs/reports/artifacts/TASK-0011A/sign-preview-browser.json --screenshot docs/reports/artifacts/TASK-0011A/sign-preview-browser.png",
    "check": "npm run typecheck && npm run lint && npm run validate:data && npm run validate:motion-spec && npm run validate:sign-packages && npm run validate:pose-pilot && npm run sync:data:check && npm run sync:technical-assets && npm run sync:technical-assets:check && npm run test && npm run build && npm run validate:assets && npm run validate:technical-asset && npm run validate:neutral-asset && npm run validate:facial-asset && npm run verify:master && npm run validate:master-static && npm run validate:morph-poc && npm run validate:master-v1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
