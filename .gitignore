# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment and editor-local files
.env
.env.*
!.env.example
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Python/Blender script caches
__pycache__/
*.py[cod]

# Blender temporary/recovery and render output
*.blend1
*.blend2
*.blend@
*.blend@*
*.autosave
blender/**/autosave/
blender/**/cache/
assets/staging/*
!assets/staging/README.md
assets/previews/*
!assets/previews/README.md

# Reviewed GLB exports and published models are intentionally trackable.
# Their binary merge/LFS policy is defined in .gitattributes and docs/workflows/.

# Generated web copy; canonical technical GLB lives in assets/exports/technical/.
apps/web/public/models/technical/*.glb
